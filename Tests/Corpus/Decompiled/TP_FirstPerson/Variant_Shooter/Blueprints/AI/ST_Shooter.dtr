StateTree(Name="Variant_Shooter/Blueprints/AI/ST_Shooter", Schema=AIComponent(AIController = BP_ShooterAIController, Actor = BP_ShooterNPC))
{
    Parameters = {
        Vector TargetMovement_Location;
        double RoamSearchBoxHalfSize       = 800;
        double RoamSearchBoxSampleDistance = 100;
        double SnipingMinDistance          = 500;
        double SnipingMaxDistance          = 2000;
    }

    Globals = { SenseEnemies = SenseEnemies(); }

    Colors = {
        Attacking       = (R = 0.137153, G = 0.003552, B = 0.00096);
        Dead            = (R = 0.097939, G = 0.084048, B = 0.112847);
        `Default Color` = (R = 0.013702, G = 0.309469, B = 0.386429);
        Investigating   = (R = 0.692708, G = 0.302522);
        Searching       = (R = 0.011455, G = 0.147826, B = 0.00475);
    }

    State Root {
        -> Dead on Tick if Actor.CurrentHP <= 0
        State Dead [ Color = Dead ] {
            if Actor.CurrentHP <= 0
            do Delay(), DebugText("Dead", ReferenceActor = Actor)
            -> TreeSucceeded
        }
        State `Armed States` {
            State `Search for Enemy` [ Color = Searching ] {
                -> `Attack Enemy` on Delegate(SenseEnemies.OnSeeEnemyDelegate) [ Priority = High ]
                -> `Investigate Location` on Delegate(SenseEnemies.OnInvestigateLocationDelegate)
                State `Find Roam Location` [ Color = Searching ] {
                    do RunEnvQuery(
                        EQS_FindRoamLocation,
                        Result      = ref Params.TargetMovement_Location,
                        QueryConfig = [
                            (ParamName = "RoamBoxSize", bAllowBBKey = false, Value = Params.RoamSearchBoxHalfSize),
                            (
                                ParamName   = "RoamBoxSampleDistance",
                                bAllowBBKey = false,
                                Value       = Params.RoamSearchBoxSampleDistance
                            )
                        ],
                        RunMode     = RandomBest25Pct
                    )
                    -> Next on Succeeded
                    -> `Idle at Roam Location` on Failed
                }
                State `Move to Roam Location` [ Color = Searching ] {
                    do MoveTo(
                           Params.TargetMovement_Location,
                           ReachTestIncludesAgentRadius = false,
                           ReachTestIncludesGoalRadius  = false
                       ),
                       DebugText("Roaming while Searching", ReferenceActor = Actor)
                    -> Next
                }
                State `Idle at Roam Location` [ Color = Searching ] {
                    do Delay(2, 1), DebugText("Idling while Searching", ReferenceActor = Actor)
                }
            }
            State `Attack Enemy` [ Color = Attacking ] {
                if ObjectIsValid(SenseEnemies.TargetActor)
                do FaceActor(ActorToFaceTowards = SenseEnemies.TargetActor),
                   RunParallelStateTree(StateTree = ST_Shooter_ShootAtTarget(Target = SenseEnemies.TargetActor))
                -> Root on Delegate(SenseEnemies.OnForgetEnemyDelegate)
                State `Find Sniping Location` [ Color = Attacking ] {
                    do RunEnvQuery(
                        EQS_FindSnipingLocation,
                        Result      = ref Params.TargetMovement_Location,
                        QueryConfig = [
                            (ParamName = "MinSnipingDistance", bAllowBBKey = false, Value = Params.SnipingMinDistance),
                            (ParamName = "MaxSnipingDistance", bAllowBBKey = false, Value = Params.SnipingMaxDistance)
                        ],
                        RunMode     = RandomBest25Pct
                    )
                    -> Next on Succeeded
                    -> `Wait at Sniping Location` on Failed
                }
                State `Move to Sniping Location` [ Color = Attacking ] {
                    do MoveTo(
                           Params.TargetMovement_Location,
                           AllowStrafe                  = true,
                           ReachTestIncludesAgentRadius = false,
                           ReachTestIncludesGoalRadius  = false
                       ),
                       DebugText("Move to Sniping Loc", ReferenceActor = Actor)
                    -> Next
                }
                State `Wait at Sniping Location` [ Color = Attacking ] {
                    do Delay(RandomDeviation = 0.75), DebugText("Attacking in Place", ReferenceActor = Actor)
                    -> `Attack Enemy`
                }
            }
            State `Investigate Location` [ Color = Investigating ] {
                do FaceLocation(FaceLocation = SenseEnemies.InvestigateLocation)
                -> `Attack Enemy` on Delegate(SenseEnemies.OnSeeEnemyDelegate) [ Priority = High ]
                -> `Move to Investigate Location` on Delegate(
                    SenseEnemies.OnInvestigateLocationDelegate
                ) [ Priority = Medium ]
                -> Root on Delegate(SenseEnemies.OnForgetEnemyDelegate)
                State `Move to Investigate Location` [ Color = Investigating ] {
                    do MoveTo(SenseEnemies.InvestigateLocation),
                       DebugText("Moving to Investigate Location", ReferenceActor = Actor)
                    -> Next
                }
                State `Wait at Investigate Location` [ Color = Investigating ] {
                    do Delay(2, 1), DebugText("Investigating", ReferenceActor = Actor)
                    -> Root
                }
            }
        }
        State Default { do Delay(0.1) }
    }
}
