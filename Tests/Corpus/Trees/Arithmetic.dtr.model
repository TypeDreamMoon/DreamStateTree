            Key Root/Negated/Task[0]/Fn:Scale
            Arg Instance Left fn
              PropertyFunction /Script/StateTreeModule.StateTreeDivideFloatPropertyFunction
                Key Root/Negated/Task[0]/Fn:Scale/Fn:Left
