Tree /Game/DreamStateTreeTests/Generated/Events.Events
  Schema /Script/DreamStateTreeTests.DstTestSchema
  Parameter float Speed = 4.000000
  State Root
    Type State
    Selection TrySelectChildrenInOrder
    Complete Any
    Transition OnEvent -> GotoState Root/Fight
      Event tag=DreamStateTreeTest.Event.Hit payload=/Script/DreamStateTreeTests.DstTestPayload consume=true
      TransitionCondition /Script/StateTreeModule.StateTreeCompareFloatCondition
        Key Root/Transition[0]/Condition[0]
        Arg Instance Left <- TransitionEvent:Root#0:Payload</Script/DreamStateTreeTests.DstTestPayload>.Severity
        Arg Instance Right = 0.500000
        Arg Node Operator = Greater
    Transition OnEvent -> GotoState Root/Observe
      Event tag=DreamStateTreeTest.Event.Hit.Light payload=/Script/DreamStateTreeTests.DstTestPayload consume=true
    Transition OnEvent -> GotoState Root/Chat
      Event tag=DreamStateTreeTest.Event.Ask payload= consume=true
    Transition OnTick -> GotoState Root
    State Root/Idle
      Type State
      Selection TrySelectChildrenInOrder
      Complete Any
      Task /Script/StateTreeModule.StateTreeDelayTask
        Key Root/Idle/Task[0]
    State Root/Fight
      Type State
