        Complete Any
        Event tag=DreamStateTreeTest.Event.Hit.Light payload=/Script/DreamStateTreeTests.DstTestPayload consume=true
        Task /Script/DreamStateTreeTests.DstTestTask
          Key Root/Fight/Light/Task[0]
          Bind LightTask
          Arg Instance InputValue <- Parameters:Speed
          Arg Instance PayloadAmount <- StateEvent:Root/Fight:Payload</Script/DreamStateTreeTests.DstTestPayload>.Amount
          Arg Instance PayloadSeverity <- StateEvent:Root/Fight/Light:Payload</Script/DreamStateTreeTests.DstTestPayload>.Severity
      State Root/Fight/Generic
        Type State
        Selection TrySelectChildrenInOrder
        Complete Any
        Task /Script/DreamStateTreeTests.DstTestTask
          Key Root/Fight/Generic/Task[0]
          Bind GenericTask
