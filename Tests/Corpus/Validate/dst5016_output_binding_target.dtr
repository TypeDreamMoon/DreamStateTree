StateTree(Name="DreamStateTreeTests/Validate/OutputBindingTarget", Schema=TestAgent)
{
    Parameters = { float Speed; float Result; }

    State Root {
        State NotAnOutput {
            do DstTestTask(InputValue = Params.Speed, Scale -> Params.Result)
        }
        State BadTarget {
            do DstTestTask(InputValue = Params.Speed, TickCount -> Owner.Level)
        }
    }
}
