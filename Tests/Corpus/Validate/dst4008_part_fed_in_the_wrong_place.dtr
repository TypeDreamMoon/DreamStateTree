StateTree(Name="DreamStateTreeTests/Validate/PartFedInTheWrongPlace", Schema=TestAgent)
{
    Parameters = { float Speed = 4; }

    State Root {
        State Number {
            do DstTestTask(InputValue = Params.Speed, Scale = (Params.Speed, 2))
            -> Field
        }
        State Field {
            do DstTestListTask(Waypoints = [(Nope = Params.Speed)])
            -> List
        }
        State List {
            do DstTestTask(InputValue = Params.Speed, Scale = [Params.Speed])
        }
    }
}
