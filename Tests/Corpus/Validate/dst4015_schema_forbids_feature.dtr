StateTree(Name="DreamStateTreeTests/Validate/SchemaForbidsFeature", Schema=RestrictedAgent)
{
    Settings = { GlobalTasksCompletion = All; }
    Parameters = { float Speed; }
    Globals = { Stats = DstTestEvaluator(); }

    State Root {
        State Folder [ Group ] {
            State Leaf {
                do Delay(1)
            }
        }
        State Picky {
            pick FollowTransitions
            State Inner {
                do Delay(1)
            }
        }
        State Gated {
            if Random(0.5)
            do Delay(1)
        }
        State Scored {
            utility 0.5
            do Delay(1)
        }
        State Busy {
            do Delay(1), Delay(2)
        }
        State Slow [ Complete = All ] {
            do Delay(1)
        }
    }
}
// EXPECT DST4015 (3,18)
